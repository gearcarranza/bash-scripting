#!/bin/bash
 
# Función para generar una contraseña aleatoria
generar_contraseña() {
    local longitud=$1
    local caracteres=$2
    # Generar contraseña aleatoria
    PASSWORD=$(< /dev/urandom tr -dc "$caracteres" | head -c "$longitud")
    # Imprimir la contraseña generada
    echo "$PASSWORD"
}
 
# Solicitar al usuario la cantidad de contraseñas a generar
read -p "Introduce la cantidad de contraseñas a generar: " cantidad
while ! [[ "$cantidad" =~ ^[1-9][0-9]*$ ]]; do
    read -p "Por favor, introduce un número válido mayor a 0: " cantidad
done
 
# Solicitar al usuario la longitud de las contraseñas
read -p "Introduce la longitud de la contraseña (mínimo 9, por defecto 9): " longitud
if [[ -z "$longitud" || "$longitud" -lt 9 ]]; then
    longitud=9
fi
 
# Opciones de caracteres
echo "Selecciona los tipos de caracteres a incluir (puedes elegir múltiples opciones separadas por comas, ej: 1,2,3):"
echo "1) Minúsculas (a-z)"
echo "2) Mayúsculas (A-Z)"
echo "3) Números (0-9)"
echo "4) Caracteres especiales (!@#\/$%^&*()_+)"
read -p "Elige tus opciones: " opciones
 
# Definir el conjunto de caracteres según la opción elegida
caracteres=""
IFS=',' read -ra seleccionadas <<< "$opciones"
for opcion in "${seleccionadas[@]}"; do
    case $opcion in
        1) caracteres+="a-z" ;;
        2) caracteres+="A-Z" ;;
        3) caracteres+="0-9" ;;
        4) caracteres+="[]@#\$%&{}*()_+" ;;
        *) echo "Opción inválida: $opcion, será ignorada." ;;
    esac
done
 
# Si no se selecciona ninguna opción, se usa la opción por defecto (todas)
if [[ -z "$caracteres" ]]; then
    echo "No se seleccionó ninguna opción válida. Se usará la combinación de todos los caracteres."
    caracteres='A-Za-z0-9!@#\$%^&*()_+'
fi
 
# Generar la cantidad de contraseñas especificada por el usuario
echo -e "\nContraseñas generadas:"
for ((i = 1; i <= cantidad; i++)); do
    echo "[$i] $(generar_contraseña "$longitud" "$caracteres")"
done